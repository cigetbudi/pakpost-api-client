{
  "manifest_version": 3,
  "name": "Pakpost Interceptor",
  "description": "Request bridge for approved Pakpost websites, with All or Specified API destination access.",
  "version": "0.3.0",
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "classic"
  },
  "action": {
    "default_title": "Pakpost Interceptor",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "pakpost-interceptor@pakpost.local",
      "strict_min_version": "128.0"
    }
  },
  "incognito": "not_allowed",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
