{
  "manifest_version": 3,
  "name": "Pakpost Interceptor",
  "description": "Manually approved bridge from Pakpost to your internal or public APIs.",
  "version": "0.1.1",
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "classic"
  },
  "action": {
    "default_title": "Pakpost Interceptor",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "pakpost-interceptor@pakpost.local",
      "strict_min_version": "128.0"
    }
  },
  "incognito": "not_allowed"
}
