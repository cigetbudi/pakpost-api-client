# PakPost Docker: copy to .env at repository root and chmod 600 .env
# Compose uses only selected variables for backend and build args for public FE.
# Example below is for LOCAL HTTP. See docs/deployment.md for HTTPS production.
COMPOSE_PROJECT_NAME=pakpost

# Local: :80 (Caddy listens on HTTP inside container) + loopback port 8080.
# VPS: set PAKPOST_SITE_ADDRESS=myproject.duckdns.org, ports 80/443 and 0.0.0.0.
PAKPOST_SITE_ADDRESS=:80
PAKPOST_PUBLIC_URL=http://localhost:8080
PAKPOST_BIND_HOST=127.0.0.1
PAKPOST_HTTP_PORT=8080
PAKPOST_HTTPS_PORT=8443
PAKPOST_ACME_EMAIL=admin@example.com
ASPNETCORE_ENVIRONMENT=Development

# Public: verified Google users can create Workspaces (10 total seats each).
# SelfHosted: creator permission managed by Instance Admin, unlimited seats.
PAKPOST_DEPLOYMENT_MODE=SelfHosted

# Trusted bridge proxy IP must lie inside this subnet. Pick unused ranges on VPS.
PAKPOST_DOCKER_SUBNET=172.30.77.0/24
PAKPOST_CADDY_IP=172.30.77.10

# Google OAuth Web Client ID is public and embedded in the Vite build.
GOOGLE_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com

# Neon PostgreSQL - use the EXISTING database; never reset an existing instance.
# Single quotes prevent interpolation of punctuation in Compose .env parser.
POSTGRES_CONNECTION_STRING='Host=YOUR_NEON_HOST;Port=5432;Database=neondb;Username=YOUR_USER;Password=YOUR_PASSWORD;SSL Mode=Require'
DB_CONNECT_TIMEOUT_SECONDS=15
DB_COMMAND_TIMEOUT_SECONDS=30
DB_MAX_POOL_SIZE=30
DB_HEALTH_TIMEOUT_SECONDS=4

# Do not regenerate existing keys if Workspaces / secrets already exist.
# New installation: generate each key independently with openssl rand -base64 N.
JWT_SIGNING_KEY=REPLACE_WITH_OUTPUT_OF_openssl_rand_base64_48
JWT_ISSUER=pakpost
JWT_AUDIENCE=pakpost-client
WORKSPACE_MASTER_KEY=REPLACE_WITH_OUTPUT_OF_openssl_rand_base64_32
WORKSPACE_MASTER_KEY_ID=master-v1
ENVIRONMENT_ENCRYPTION_KEY=REPLACE_WITH_OTHER_OUTPUT_OF_openssl_rand_base64_32

# Invitation SMTP (e.g. Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=you@gmail.com
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=REPLACE_WITH_GMAIL_APP_PASSWORD

# API proxy must not be allowed to reach private/internal networks by default.
PROXY_ALLOW_PRIVATE_NETWORKS=false
REQUEST_TIMEOUT_DEFAULT_SECONDS=90
REQUEST_TIMEOUT_AUTH_SECONDS=30
REQUEST_TIMEOUT_PROXY_SECONDS=25

# Optional DuckDNS updater (enable with --profile duckdns; no wildcard).
# Subdomain WITHOUT .duckdns.org, e.g. "myproject" for myproject.duckdns.org
DUCKDNS_SUBDOMAIN=myproject
DUCKDNS_TOKEN=REPLACE_WITH_DUCKDNS_TOKEN

# Desktop remote authentication is opt-in on the server.
DESKTOP_AUTH_ENABLED=false
# Linux VPS only: provision Data Protection directories first (docs/deployment.md).
# COMPOSE_FILE=compose.yaml:compose.production-hardening.yaml
# DB_DISABLE_GSS_ENCRYPTION=true
