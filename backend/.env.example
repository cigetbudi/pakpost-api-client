# NEW empty Neon database / branch only. Do not paste this file in chat.
ConnectionStrings__Postgres='Host=YOUR_NEON_HOST;Port=5432;Database=neondb;Username=YOUR_USER;Password=YOUR_PASSWORD;SSL Mode=Require'
Jwt__SigningKey='REPLACE_WITH_OUTPUT_OF_openssl_rand_base64_48'
Jwt__Issuer='pakpost'
Jwt__Audience='pakpost-client'
ASPNETCORE_URLS='http://127.0.0.1:5080'
ASPNETCORE_ENVIRONMENT='Development'
# By default proxy can only hit public IPv4/IPv6 networks on ports 80 or 443.
# To test localhost from this API in local dev, set true and add test ports below.
Proxy__AllowPrivateNetworks='false'
Proxy__AllowedPorts__0='80'
Proxy__AllowedPorts__1='443'
# Proxy__AllowedPorts__2='8000'
Cors__AllowedOrigins__0='http://localhost:5173'
Cors__AllowedOrigins__1='http://127.0.0.1:5173'

# Required for workspace-level encryption. Do not rotate without rewrapping all DEKs.
WorkspaceEncryption__MasterKey='REPLACE_WITH_OUTPUT_OF_openssl_rand_base64_32'
# The initial ID is master-v1. Change this ONLY after an offline DEK rewrap.
WorkspaceEncryption__MasterKeyId='master-v1'
# Keep the existing EnvironmentEncryption__Key for secret variables and revision history.
EnvironmentEncryption__Key='REPLACE_WITH_OUTPUT_OF_openssl_rand_base64_32'

Google__ClientId='XXXX'

Invitations__FrontendBaseUrl='http://127.0.0.1:5173/'


Invitations__Smtp__Host='smtp.gmail.com'
Invitations__Smtp__Port='587'
Invitations__Smtp__From='XX@gmail.com'
Invitations__Smtp__Username='XX@gmail.com'
Invitations__Smtp__Password='XXX'

# Phase 10: request timeouts and PostgreSQL connection limits (seconds).
# Override only if measured latencies and network conditions require it.
Database__ConnectTimeoutSeconds='15'
Database__CommandTimeoutSeconds='30'
Database__MaxPoolSize='30'
Database__HealthTimeoutSeconds='4'
RequestTimeout__DefaultSeconds='90'
RequestTimeout__AuthSeconds='30'
RequestTimeout__ProxySeconds='25'

# Google-only sign-in is the default. Use true ONLY during controlled legacy-account migration.
Authentication__EnableLegacyPasswordLogin=false

# Deployment policy. Explicitly choose Public for the hosted SaaS.
# Public: Google verified users can create workspaces; 10 seats per workspace.
# SelfHosted (safe default): admin grants Workspace Creator; unlimited seats.
Pakpost__DeploymentMode='SelfHosted'