{
	email {$PAKPOST_ACME_EMAIL}
	# Runtime error logs also contain request metadata. Remove it only from logs,
	# never from the actual upstream request (CSRF and authentication stay intact).
	log {
		output stderr
		format filter {
			wrap json
			fields {
				request>headers delete
				request>uri delete
				resp_headers delete
			}
		}
	}
}

# :80 for localhost HTTP; pakpost-name.duckdns.org for VPS automatic HTTPS.
{$PAKPOST_SITE_ADDRESS} {
	encode zstd gzip

	@pakpost_api path /api /api/* /hubs /hubs/* /health /health/*
	handle @pakpost_api {
		reverse_proxy backend:8080 {
			# Retry connection failures during container replacement. After a
			# connection is established only read-only GET/HEAD may be retried.
			lb_try_duration 5s
			lb_try_interval 250ms
			lb_retry_match {
				method GET HEAD
			}
		}
	}

	handle {
		reverse_proxy frontend:8080 {
			lb_try_duration 5s
			lb_try_interval 250ms
			lb_retry_match {
				method GET HEAD
			}
		}
	}
}
