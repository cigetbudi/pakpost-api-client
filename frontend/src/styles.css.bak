@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap');
:root{font-family:'DM Sans',Inter,system-ui,-apple-system,sans-serif;color-scheme:dark;--bg:#0b111a;--surface:#101925;--surface2:#141f2c;--elevated:#182536;--border:#253244;--muted:#7f90a7;--text:#ecf3f9;--green:#8cf0bd;--green-soft:rgba(117,234,176,.11);--hover:#1b2b3d;--shadow:0 22px 80px rgba(0,0,0,.2)}
:root[data-theme='light']{color-scheme:light;--bg:#f5f7fa;--surface:#fff;--surface2:#f9fbfc;--elevated:#f4f8f8;--border:#e3eaf0;--muted:#74849a;--text:#17253a;--green:#168d61;--green-soft:rgba(22,141,97,.09);--hover:#f1f6f7;--shadow:0 14px 38px rgba(29,55,81,.06)}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-size:14px}button,input,textarea,select{font:inherit}button{cursor:pointer}button:disabled{cursor:not-allowed;opacity:.55}input,textarea,select{outline:none;color:var(--text)}input:focus,textarea:focus,select:focus{border-color:var(--green)!important;box-shadow:0 0 0 2px var(--green-soft)}h1,h2,h3,p{margin-top:0}h1{letter-spacing:-1.5px}h2,h3{letter-spacing:-.35px}a{color:inherit}.muted{color:var(--muted)}.smaller{font-size:12px}.app-shell{display:flex;min-height:100vh}.sidebar{position:sticky;top:0;height:100vh;flex:0 0 250px;background:var(--surface);border-right:1px solid var(--border);display:flex;flex-direction:column;padding:29px 17px 18px}.brand{display:flex;gap:12px;align-items:center;padding:0 10px 46px}.brand-mark{width:39px;height:39px;display:grid;place-items:center;background:var(--green);color:#0b2119;border-radius:12px}.brand-copy{display:flex;flex-direction:column;gap:1px}.brand-copy strong{font-weight:800;font-size:23px;letter-spacing:-1px;line-height:1}.brand-copy strong span{color:var(--green)}.brand-copy small{font-size:9px;font-weight:800;letter-spacing:1.8px;color:var(--muted);margin-top:5px}.sidebar-caption,.sidebar-section>span,.panel-title{font-size:10px;font-weight:800;letter-spacing:1.5px;color:var(--muted);padding:0 12px;margin-bottom:12px}.nav-item{width:100%;display:flex;align-items:center;gap:13px;padding:13px 12px;border:none;border-radius:9px;background:transparent;color:var(--muted);font-weight:700;text-align:left;margin:3px 0}.nav-item span:nth-child(2){flex:1}.nav-item.active{background:var(--green-soft);color:var(--green)}.nav-item:hover{background:var(--hover)}.nav-tag{font-size:9px;letter-spacing:.7px;background:var(--green-soft);color:var(--green);border-radius:4px;padding:3px 5px}.sidebar-section{margin-top:36px}.sidebar-panel{border:1px solid var(--border);border-radius:10px;background:var(--surface2);padding:16px 14px;margin:0 4px;position:relative}.sidebar-panel .status-dot{width:7px;height:7px;border-radius:50%;background:var(--green);display:inline-block;margin-right:5px}.sidebar-panel strong{font-size:12px}.sidebar-panel p{margin:9px 0 0;color:var(--muted);font-size:11px;line-height:1.6}.sidebar-bottom{margin-top:auto}.user-card{display:flex;align-items:center;gap:11px;padding:15px 7px;border-top:1px solid var(--border)}.avatar{border-radius:11px;background:var(--elevated);border:1px solid var(--border);width:38px;height:38px;display:grid;place-items:center;color:var(--green);font-weight:800}.avatar.small{height:33px;width:33px;font-size:12px}.user-meta{display:flex;flex-direction:column;gap:5px;min-width:0}.user-meta strong{font-size:12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.user-meta span{color:var(--muted);font-size:10px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.sidebar-action{width:100%;display:flex;align-items:center;justify-content:center;gap:8px;padding:12px;border:1px solid var(--border);border-radius:8px;color:var(--text);background:var(--surface2);font-weight:700;font-size:12px}.sidebar-action:hover{border-color:var(--green);color:var(--green)}.main{width:calc(100% - 250px);min-width:0;max-width:1600px;flex:1;padding:0 40px}.topbar{min-height:84px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--border)}.breadcrumbs{display:flex;gap:12px;align-items:center;font-size:12px;color:var(--muted)}.breadcrumbs strong{color:var(--text)}.slash{opacity:.5}.top-actions{display:flex;align-items:center;gap:14px}.build-label{font-size:10px;font-weight:800;letter-spacing:1px;color:var(--muted);display:flex;gap:7px;align-items:center}.green-dot{width:7px;height:7px;background:var(--green);border-radius:50%;display:inline-block;box-shadow:0 0 0 4px var(--green-soft)}.icon-btn{color:var(--muted);border:1px solid transparent;background:transparent;padding:8px;border-radius:7px;display:inline-grid;place-items:center}.icon-btn:hover{background:var(--hover);color:var(--text)}.btn{display:inline-flex;align-items:center;justify-content:center;gap:9px;border-radius:8px;padding:11px 18px;font-weight:800;font-size:12px;transition:background .15s,border-color .15s}.btn.primary{background:var(--green);color:#0d2319;border:1px solid var(--green)}.btn.primary:hover{filter:brightness(.93)}.btn.secondary{background:var(--surface2);color:var(--text);border:1px solid var(--border)}.btn.secondary:hover{border-color:var(--green)}.btn.compact{padding:9px 13px}.btn.full{width:100%;margin-top:10px}.hero{padding:46px 0 31px}.hero .eyebrow{color:var(--green);font-size:10px;letter-spacing:1.7px;font-weight:800;display:flex;align-items:center;gap:8px;margin-bottom:14px}.eyebrow-dot{width:7px;height:7px;background:var(--green);transform:rotate(45deg);border-radius:1px}.hero h1{font-size:37px;line-height:1.13;margin-bottom:9px;font-weight:800}.hero p{font-size:13px;color:var(--muted);margin:0}.workbench,.response-card,.recent-card,.workspace-picker,.workspace-details{border:1px solid var(--border);background:var(--surface);border-radius:13px;overflow:hidden;box-shadow:var(--shadow)}.section-head{display:flex;align-items:center;justify-content:space-between;gap:15px;padding:23px 26px}.section-head h2{font-size:15px;display:flex;align-items:center;gap:10px;margin:0 0 7px;font-weight:800}.section-head h2 svg{color:var(--green)}.section-head p{font-size:11px;color:var(--muted);margin:0}.head-utilities span{display:flex;align-items:center;gap:7px;font-size:11px;color:var(--green);background:var(--green-soft);padding:7px 10px;border-radius:7px}.request-line{display:flex;align-items:stretch;gap:0;margin:0 26px 23px;border:1px solid var(--border);border-radius:9px;background:var(--surface2);overflow:hidden;height:48px}.request-line:focus-within{border-color:var(--green)}.request-line select{padding:0 13px;background:var(--elevated);color:var(--green);border:0;border-right:1px solid var(--border);font-family:'JetBrains Mono',monospace;font-size:11px;font-weight:800;min-width:106px;cursor:pointer}.request-line input{background:transparent;border:0;color:var(--text);padding:0 15px;flex:1;min-width:100px;font-family:'JetBrains Mono',monospace;font-size:12px}.request-line input:focus,.request-line select:focus{box-shadow:none}.send-btn{border-radius:0!important;padding:0 22px!important}.tabbar{border-top:1px solid var(--border);border-bottom:1px solid var(--border);display:flex;align-items:stretch;gap:6px;padding:0 23px;min-height:44px}.tabbar>button:not(.icon-btn){border:0;border-bottom:2px solid transparent;padding:13px 9px 11px;background:transparent;color:var(--muted);font-size:12px;font-weight:700;display:flex;align-items:center;gap:8px}.tabbar>button.chosen{color:var(--green);border-bottom-color:var(--green)}.tabbar>button:hover{color:var(--text)}.count{font-size:10px;color:var(--muted);padding:2px 6px;background:var(--elevated);border-radius:4px}.request-edit{min-height:150px;padding:15px 26px 19px}.table-heading,.header-row{display:grid;grid-template-columns:1fr 1fr 30px;gap:9px;align-items:center}.table-heading{font-size:10px;letter-spacing:1px;color:var(--muted);font-weight:800;margin:0 0 9px}.header-row{margin-bottom:8px}.header-row input,.inline-add input,.modal-form input,.modal-form select{padding:10px 12px;background:var(--surface2);color:var(--text);border:1px solid var(--border);border-radius:7px;min-width:0;width:100%;font-size:12px}.header-row input{font-family:'JetBrains Mono',monospace}.text-action{display:flex;align-items:center;gap:6px;border:0;background:transparent;color:var(--green);font-weight:800;font-size:11px;padding:9px 0}.editor-caption{color:var(--muted);font-size:11px;display:flex;align-items:center;gap:7px;margin-bottom:12px}.editor-caption span{margin-left:auto}.body-editor{width:100%;min-height:158px;resize:vertical;background:var(--surface2);padding:13px;border:1px solid var(--border);border-radius:8px;font:12px/1.7 'JetBrains Mono',monospace}.builder-footer{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:15px 26px;border-top:1px solid var(--border)}.helper-text{display:flex;align-items:center;gap:8px;font-size:10px;line-height:1.4}.response-card{margin-top:22px;min-height:265px}.response-heading{border-bottom:1px solid var(--border)}.response-stats{display:flex;align-items:center;gap:17px;font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--muted)}.response-stats span{display:flex;gap:6px;align-items:center}.response-stats .status-good{color:var(--green);font-weight:800}.response-stats .status-bad{color:#ff9b89;font-weight:800}.empty{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:38px 15px;text-align:center}.empty-icon{background:var(--elevated);border:1px solid var(--border);color:var(--muted);width:49px;height:49px;display:grid;place-items:center;border-radius:13px;margin-bottom:16px}.empty strong{font-size:13px}.empty p{max-width:300px;color:var(--muted);font-size:11px;line-height:1.7;margin:8px 0 0}.tab-spacer{flex:1}.response-code{padding:22px 26px 30px;margin:0;min-height:160px;max-height:520px;overflow:auto;background:var(--surface);font:12px/1.72 'JetBrains Mono',monospace;white-space:pre-wrap;overflow-wrap:anywhere}.error-response{padding:30px;color:#f1a697}.error-response p{margin-top:8px;color:var(--muted);white-space:pre-wrap}.response-warning{color:#e2ad61;padding:0 25px;font-size:12px}.recent-card{margin-top:22px}.recent-card h3{margin:0;padding:18px 24px;border-bottom:1px solid var(--border);font-size:12px;display:flex;align-items:center;gap:8px}.history-list button{display:flex;align-items:center;width:100%;gap:13px;padding:13px 24px;border:0;border-bottom:1px solid var(--border);background:transparent;color:var(--muted);text-align:left;font-size:12px}.history-list button:hover{background:var(--hover)}.history-url{color:var(--text);flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-family:'JetBrains Mono',monospace;font-size:11px}.method-pill{font:800 10px 'JetBrains Mono',monospace;color:var(--green);background:var(--green-soft);padding:6px 7px;border-radius:5px;min-width:49px;text-align:center}.method-pill.post,.method-pill.patch{color:#e8b574;background:rgba(232,181,116,.11)}.method-pill.delete{color:#e89a93;background:rgba(232,154,147,.11)}.history-status{font:700 11px 'JetBrains Mono',monospace;color:var(--green)}.history-time{min-width:55px;text-align:right}.footer{margin:35px 0 25px;display:flex;justify-content:space-between;gap:14px;color:var(--muted);font-size:10px;letter-spacing:.5px}.footer span:last-child{display:flex;align-items:center;gap:7px}.workspace-hero{padding-bottom:31px}.workspace-grid{display:grid;grid-template-columns:minmax(225px,290px) minmax(0,1fr);gap:20px;align-items:start}.workspace-picker{padding:20px 14px;min-height:460px}.panel-title{display:flex;align-items:center;justify-content:space-between}.inline-add{display:flex;gap:6px}.small-add{background:var(--green);color:#0d2319;border:0;width:35px;flex:none;display:grid;place-items:center;border-radius:7px}.workspace-picker .inline-add{margin:10px 4px 15px}.workspace-list button{display:flex;align-items:center;gap:10px;width:100%;padding:10px;border-radius:8px;border:0;background:transparent;color:var(--muted);text-align:left}.workspace-list button span{flex:1;overflow:hidden;text-overflow:ellipsis}.workspace-list button.current,.workspace-list button:hover{background:var(--green-soft);color:var(--green)}.workspace-avatar{border-radius:8px;width:33px;height:33px;display:grid;place-items:center;color:var(--green);background:var(--green-soft)}.workspace-avatar.large{width:47px;height:47px;border-radius:10px}.tiny-padding{padding:12px;font-size:12px}.workspace-details{min-height:460px}.ws-top{display:flex;align-items:center;justify-content:space-between;padding:23px 24px}.ws-title{display:flex;align-items:center;gap:13px}.ws-title h2{margin:0 0 6px;font-size:17px}.ws-title p{margin:0;font-size:11px;color:var(--muted)}.private-label{display:flex;align-items:center;gap:7px;background:var(--green-soft);color:var(--green);padding:7px 9px;border-radius:7px;font-size:10px;font-weight:800}.workspace-tabs{padding-left:18px}.workspace-content{padding:22px 24px}.content-top{display:flex;align-items:center;justify-content:space-between;gap:13px;margin-bottom:15px}.content-top strong{font-size:13px}.content-top .inline-add input{width:170px}.collection-row{display:flex;align-items:center;gap:12px;border:1px solid var(--border);background:var(--surface2);width:100%;padding:13px;color:var(--muted);border-radius:8px;margin-bottom:8px;text-align:left}.collection-row.current{border-color:var(--green);background:var(--green-soft)}.collection-row span:nth-child(2){flex:1;color:var(--text);font-weight:700;font-size:12px}.collection-row .muted{font-size:10px}.collection-row:hover{border-color:var(--green)}.saved-zone{border-top:1px solid var(--border);margin-top:24px;padding-top:17px}.saved-zone h3{font-size:12px}.saved-row{display:flex;align-items:center;gap:11px;padding:11px 0;border-bottom:1px solid var(--border)}.saved-open{background:transparent;border:0;display:flex;flex:1;flex-direction:column;min-width:0;text-align:left;gap:4px;color:var(--text)}.saved-open strong{font-size:12px}.saved-open small{color:var(--muted);max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.member-row{display:flex;align-items:center;gap:11px;border-bottom:1px solid var(--border);padding:12px 0}.member-row>div:nth-child(2){flex:1;min-width:0}.member-row strong{font-size:12px;display:block}.member-row small{color:var(--muted);font-size:10px}.role-badge{font-size:10px;font-weight:800;padding:5px 8px;border:1px solid var(--border);border-radius:5px;color:var(--muted)}.footnote{margin-top:15px}.toast{position:fixed;right:25px;bottom:25px;z-index:11;background:var(--elevated);border:1px solid var(--border);border-radius:9px;box-shadow:var(--shadow);display:flex;align-items:center;gap:17px;max-width:440px;padding:14px 15px;font-size:12px}.toast button{background:none;border:0;color:var(--muted)}.overlay{position:fixed;inset:0;z-index:20;background:rgba(2,8,17,.7);display:grid;place-items:center;padding:15px;backdrop-filter:blur(5px)}.dialog{background:var(--surface);border:1px solid var(--border);border-radius:15px;width:min(100%,420px);box-shadow:0 30px 90px rgba(0,0,0,.3);padding:25px}.dialog-top{display:flex;justify-content:space-between;gap:10px;align-items:start;padding-bottom:17px}.dialog-top h2{margin:0 0 8px;font-size:21px}.dialog-top p{color:var(--muted);font-size:12px;line-height:1.6;margin:0}.modal-form{display:flex;flex-direction:column;gap:16px}.modal-form label{display:flex;flex-direction:column;gap:7px;color:var(--muted);font-size:11px;font-weight:700}.modal-form input,.modal-form select{font-size:13px;padding:12px}.form-error{color:#ed948d;background:rgba(235,116,111,.09);border:1px solid rgba(235,116,111,.2);padding:11px;border-radius:7px;font-size:12px}.form-toggle{margin:0;text-align:center;color:var(--muted);font-size:12px}.form-toggle button{border:0;background:transparent;color:var(--green);font-weight:800}.text-center{text-align:center;margin:0}.spinner{height:14px;width:14px;border-radius:50%;border:2px solid rgba(10,38,27,.25);border-top-color:#133423;animation:spin .9s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}
@media(max-width:1060px){.main{padding:0 24px}.sidebar{flex-basis:218px}.workspace-grid{grid-template-columns:230px minmax(0,1fr)}.content-top{align-items:stretch;flex-direction:column}.content-top .inline-add input{width:100%}}@media(max-width:780px){.sidebar{flex:0 0 68px;padding:18px 8px}.brand{padding:0 5px 35px}.brand-copy,.sidebar-caption,.nav-item>span,.sidebar-section,.sidebar-bottom .user-meta,.sidebar-action{display:none}.nav-item{justify-content:center;padding:14px}.sidebar-bottom .user-card{justify-content:center}.main{width:calc(100% - 68px);padding:0 17px}.hero h1{font-size:29px}.workspace-grid{grid-template-columns:1fr}.workspace-picker{min-height:unset}.workspace-list{display:flex;flex-wrap:wrap}.workspace-list button{width:auto}.response-stats{gap:8px;font-size:10px}}@media(max-width:500px){.main{padding:0 11px}.topbar{min-height:66px}.build-label{display:none}.hero{padding-top:28px}.hero h1{font-size:26px}.section-head{padding:19px 14px}.request-line{margin:0 13px 15px}.request-line select{min-width:77px;padding:0 4px}.send-btn{padding:0 11px!important}.tabbar{padding:0 12px}.request-edit{padding:15px}.builder-footer{padding:13px;flex-direction:column;align-items:stretch}.builder-footer .btn{width:100%}.response-stats{flex-wrap:wrap}.footer span:last-child{display:none}.content-top{flex-direction:column}.ws-top{padding:18px}.workspace-content{padding:17px}.history-time{display:none}}
